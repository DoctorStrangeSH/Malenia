{
  "manifest_version": 3,
  "name": "Malenia Browser Bridge",
  "version": "1.7.0",
  "description": "Read explicitly authorized resource pages with a bounded read-only background task.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "tabs",
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Malenia Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
