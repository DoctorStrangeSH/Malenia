{
  "manifest_version": 3,
  "name": "Маления",
  "version": "1.8.0",
  "description": "Связывает рабочие вкладки с приложением Маления: инвентаризация, DataLens, Asgard. Только чтение разрешённых страниц.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_title": "Маления — помощник в браузере",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
